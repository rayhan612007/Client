# BetterAuth
# NOTE: better-auth reads BETTER_AUTH_SECRET (not BETTERAUTH_SECRET) —
# without it the app runs on the default dev secret and hard-errors in production.
BETTER_AUTH_SECRET=change_this_secret
# Production domain(s) for auth callbacks/redirects (comma-separated)
BETTER_AUTH_TRUSTED_ORIGINS=https://your-domain.com
# Public URL of this frontend (fixes the "Base URL is not set" warning)
BETTER_AUTH_URL=http://localhost:3000

# MongoDB (shared with the backend)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fixmate

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# ImgBB (image uploads via API endpoint)
NEXT_IMGBB_API_KEY=xxx
